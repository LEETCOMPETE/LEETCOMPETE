# Environment variables for LeetCompete Server

# JWT Authentication secret key
JWT_SECRET="leetcompete-super-secret-key-2026"

# Database Connection URL (SQLite default)
DATABASE_URL="sqlite:///./leetcompete.db"

# Judge0 API settings (Optional: leave blank for built-in local execution)
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# AI LLM Provider Keys (Optional: Gemini or OpenAI for AI Hints & Feedback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
